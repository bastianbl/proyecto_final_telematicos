# Puertos y balanceo
BALANCER_PORT=8080
BACKEND_COUNT=3
BALANCER_METHOD=byrequests
# Modo de los backends: fijo (backend1..N, por defecto) o scale (réplicas creadas
# con "docker compose up --scale backend=N"). No hace falta tocarlo: "make scale"
# lo pone solo.
# BACKEND_MODE=fijo

# Carga por defecto para GET /work en los backends
WORK_DELAY_MS=200
WORK_CPU_MS=0
WORK_MAX_MS=10000

# Artillery ya no se configura aquí: usa su propia imagen con versión fija
# (pruebas/Dockerfile). ARTILLERY_IMAGE dejó de usarse; si quedó en tu .env,
# se ignora.
